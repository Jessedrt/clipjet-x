# Copy to .env ONLY on your own computer. NEVER commit the real .env file.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_HERE
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET
APP_URL=https://clipjet-x.vercel.app
# Optional: your own numeric Telegram user ID to limit testing to yourself.
BOT_OWNER_ID=
# Optional YouTube fallback: YOUR OWN or an explicitly authorized Cobalt API instance.
# Do not use api.cobalt.tools or an unknown public instance without permission.
# Keep empty until you have a real HTTPS instance. Host must be its origin, no /path.
COBALT_API_URL=
# Optional key provided by the instance owner (store only in Vercel secrets or private .env).
COBALT_API_KEY=
