# Copy to .env ONLY on your own computer. NEVER commit the real .env file.
BOT_TOKEN=YOUR_NEW_BOT_TOKEN_HERE
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=REPLACE_WITH_GENERATED_SECRET
APP_URL=https://clipjet-x.vercel.app
# Optional: your own numeric Telegram user ID to limit testing to yourself.
BOT_OWNER_ID=

# Optional YouTube fallback: your own or an explicitly authorized Cobalt instance.
# Leave empty until you have a real HTTPS API at the domain origin.
COBALT_API_URL=
COBALT_API_KEY=

# Optional short-video SocialKit fallback: one successful API call can spend credits.
# Obtain your key from YOUR SocialKit account. Never commit or send it in chat.
# Both fields are needed; leave false until you agree to enable paid-credit requests.
SOCIALKIT_ACCESS_KEY=
SOCIALKIT_ENABLED=false
